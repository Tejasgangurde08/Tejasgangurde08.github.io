  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: 0.78rem; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); background: rgba(10, 3, 24, 0.5); }
  .badge { display: inline-block; font-size: 0.72rem; padding: 3px 12px; border-radius: 999px; color: #e9d5ff; background: rgba(168, 85, 247, 0.22); border: 1px solid rgba(168, 85, 247, 0.5); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }

<script>
  /* ============ EDIT ONLY THIS BLOCK ============
     Leave a value as "" and that item stays hidden on the page. */
  const ME = {
    email: "",          // e.g. "yourname@gmail.com"
    phone: "",          // e.g. "+91 98765 43210"  (only add it if you want it public)
    whatsapp: "",       // digits with country code, e.g. "919876543210"
    location: "Malegaon, Maharashtra, India",
    college: "K.K. Wagh",
    course: "BSc Computer Science, 2nd Year",
    linkedin: "",       // e.g. "https://linkedin.com/in/yourname"
    github: "",         // e.g. "https://github.com/yourname"
    resume: "",         // e.g. "resume.pdf" (put the file next to index.html)
    roadLive: "",   roadCode: "",
    phishLive: "",  phishCode: "",
    forensicsLive: "", forensicsCode: ""
  };

  const PHRASES = [
    "I'm learning Full Stack Development.",
    "I'm learning Data Analysis.",
    "I'm exploring Cybersecurity."
  ];

  /* Tools per tab (up to 5 each). Delete any tool you don't actually use. */
  const TOOLS = {
    "Offensive":    ["Metasploit", "Nmap", "Hydra", "John the Ripper", "SQLmap"],
    "Defensive":    ["Wireshark", "Snort", "Fail2Ban", "ClamAV", "Autopsy"],
    "Web Security": ["Burp Suite", "OWASP ZAP", "Nikto", "Gobuster", "SQLmap"],
    "Networking":   ["Wireshark", "Nmap", "Netcat", "Packet Tracer", "tcpdump"],
    "Languages":    ["Python", "JavaScript", "Java", "C", "C++"],
    "Data Analyst": ["Excel", "SQL", "Pandas", "Power BI", "Jupyter"]
  };

  const PLATFORMS = [
    ["🐉", "Kali Linux"], ["🟠", "Ubuntu"], ["🪟", "Windows"],
    ["🚩", "TryHackMe"], ["📦", "Hack The Box"], ["☁️", "Azure"]
  ];
  /* ============================================== */

  const hrefFor = (k, v) =>
    k === 'email' ? 'mailto:' + v :
    k === 'phone' ? 'tel:' + v.replace(/\s/g, '') :
    k === 'whatsapp' ? 'https://wa.me/' + v.replace(/\D/g, '') : v;

  // links, icons and rows that use data-key
  document.querySelectorAll('[data-key]').forEach(el => {
    const k = el.dataset.key, v = ME[k];
    if (!v) { el.hidden = true; return; }
    el.hidden = false;
    if (el.tagName === 'A') el.href = hrefFor(k, v);
    const val = el.querySelector('.val');
    if (val) val.textContent = v.replace(/^https?:\/\/(www\.)?/, '');
  });
  // fact rows in the About card
  document.querySelectorAll('[data-row]').forEach(el => {
    const v = ME[el.dataset.row];
    if (!v) { el.hidden = true; return; }
    el.querySelector('.val').textContent = v;
  });

  // tools tabs
  const tabs = document.getElementById('tabs');
  const tiles = document.getElementById('toolTiles');
  const initials = s => s.split(/[\s-]+/).map(w => w[0]).join('').slice(0, 2).toUpperCase();
  function showTab(name) {
    tabs.querySelectorAll('.tab').forEach(t => t.setAttribute('aria-selected', t.dataset.name === name));
    tiles.innerHTML = TOOLS[name].map(t =>
      `<div class="tile"><div class="mono">${initials(t)}</div>${t}</div>`).join('');
  }
  Object.keys(TOOLS).forEach((name, i) => {
    const b = document.createElement('button');
    b.className = 'tab'; b.type = 'button'; b.setAttribute('role', 'tab'); b.dataset.name = name; b.textContent = name;
    b.addEventListener('click', () => showTab(name));
    tabs.appendChild(b);
    if (i === 0) showTab(name);
  });

  // platforms
  document.querySelector('.tiles.plat').innerHTML = PLATFORMS.map(([icon, name]) =>
    `<div class="tile"><div class="mono">${icon}</div>${name}</div>`).join('');

  // mobile menu
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('menu');
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('open');
    btn.setAttribute('aria-expanded', open);
  });
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
  }));

  // typing effect
  const typed = document.getElementById('typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    typed.textContent = PHRASES[0];
  } else {
    let p = 0, i = 0, deleting = false;
    (function tick() {
      const word = PHRASES[p];
      typed.textContent = word.slice(0, i);
      if (!deleting && i === word.length) { deleting = true; return setTimeout(tick, 1800); }
      if (deleting && i === 0) { deleting = false; p = (p + 1) % PHRASES.length; }
      i += deleting ? -1 : 1;
      setTimeout(tick, deleting ? 35 : 75);
    })();
  }

  document.getElementById('year').textContent = new Date().getFullYear();
</script>

  /* TOOLS */
  .tabs { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 20px; scrollbar-width: thin; }
  .tab { flex: none; background: rgba(10, 3, 24, 0.5); color: var(--muted); border: 1px solid var(--line); border-radius: 10px; padding: 9px 16px; font: inherit; font-size: 0.85rem; cursor: pointer; transition: color .2s, border-color .2s, background .2s; }
  .tab:hover { color: var(--text); border-color: var(--violet); }

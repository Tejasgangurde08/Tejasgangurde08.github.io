  nav a { color: var(--muted); font-size: 0.88rem; transition: color .2s; }
  nav a:hover { color: var(--text); }
  .menu-btn { display: none; background: none; border: 1px solid var(--line); color: var(--text); width: 40px; height: 40px; border-radius: 10px; font-size: 1.1rem; cursor: pointer; }

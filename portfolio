  .plat .mono { font-size: 1.3rem; background: rgba(124, 58, 237, 0.25); border: 1px solid var(--line); }

  /* PROJECTS */
  .proj { display: grid; gap: 16px; margin-bottom: 72px; align-items: center; }
  .proj:last-child { margin-bottom: 0; }
  @media (min-width: 760px) {
    .proj { grid-template-columns: 1.1fr 1fr; gap: 0; }
    .proj.flip .shot { order: 2; }
    .proj .info { margin-left: -64px; z-index: 2; }
    .proj.flip .info { margin-left: 0; margin-right: -64px; text-align: right; }
    .proj.flip .chips, .proj.flip .icons { justify-content: flex-end; }
  }
  .shot { aspect-ratio: 16 / 10; background: #f4f1fa; border-radius: 6px; overflow: hidden; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45); display: flex; flex-direction: column; color: #2a1a44; }
  .shot .bar { display: flex; gap: 5px; padding: 8px 10px; background: #e5def2; }
  .shot .bar i { width: 7px; height: 7px; border-radius: 50%; background: #b9a8dc; }
  .shot .body { flex: 1; display: grid; place-items: center; text-align: center; font-weight: 600; font-size: clamp(0.95rem, 2.4vw, 1.25rem); padding: 14px; }
  .shot .body span { display: block; font-size: 2rem; margin-bottom: 6px; }
  .shot img { width: 100%; height: 100%; object-fit: cover; }
  .label { color: var(--violet); font-size: 0.75rem; }
  .info h3 { font-size: 1.3rem; font-weight: 500; margin-bottom: 10px; }
  .info .desc { background: rgba(88, 40, 160, 0.4); backdrop-filter: blur(8px); border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px; font-size: 0.86rem; color: #ddd0f5; margin-bottom: 12px; text-align: left; }
  .icons { display: flex; gap: 14px; margin-top: 14px; }
  .icons a { display: inline-flex; opacity: 0.85; }
  .icons a:hover { opacity: 1; color: var(--violet); }
  .icons svg { width: 22px; height: 22px; fill: currentColor; }

  /* CONTACT */
  .contact { display: grid; gap: 28px; }
  @media (min-width: 860px) { .contact { grid-template-columns: 1fr 1.1fr; align-items: start; } }
  .contact h3 { font-size: 1.3rem; margin-bottom: 12px; }
  .contact p { color: var(--muted); max-width: 46ch; }
  .list { display: grid; gap: 10px; }
  .row { display: flex; flex-direction: column; padding: 14px 18px; border: 1px solid var(--line); border-radius: 12px; background: rgba(18, 6, 42, 0.7); transition: border-color .2s; word-break: break-word; }
  a.row:hover { border-color: var(--violet); }
  .row small { color: var(--muted); font-size: 0.74rem; }
  .wa { background: rgba(22, 101, 52, 0.25); border-color: rgba(34, 197, 94, 0.5); color: #86efac; }
  .wa:hover { border-color: #22c55e; }
  footer { padding: 28px 0 36px; text-align: center; color: var(--muted); font-size: 0.8rem; border-top: 1px solid var(--line); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .cursor { animation: none; }
    .btn, .tab { transition: none; }
  }
</style>
